{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (newData == null && data.child('meta/createdBy').val() === auth.uid))",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)"
        },
        "players": {
          "$playerId": {
            ".write": "auth != null && (root.child('rooms').child($room).child('meta/createdBy').val() === auth.uid || (newData.exists() && newData.child('authUid').val() === auth.uid) || (data.exists() && data.child('authUid').val() === auth.uid)) && (!data.exists() || !newData.exists() || data.child('authUid').val() === newData.child('authUid').val())"
          }
        },
        "currentRound": {
          ".write": "auth != null && root.child('rooms').child($room).child('meta/createdBy').val() === auth.uid",
          "answers": {
            "$playerId": {
              ".write": "auth != null && root.child('rooms').child($room).child('players').child($playerId).exists() && root.child('rooms').child($room).child('players').child($playerId).child('authUid').val() === auth.uid"
            }
          }
        },
        "usedSongIds": {
          ".write": "auth != null && root.child('rooms').child($room).child('meta/createdBy').val() === auth.uid"
        },
        "customSongs": {
          ".write": "auth != null && root.child('rooms').child($room).child('meta/createdBy').val() === auth.uid"
        },
        "history": {
          ".write": "auth != null && root.child('rooms').child($room).child('meta/createdBy').val() === auth.uid"
        }
      }
    },
    "globalSongs": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
